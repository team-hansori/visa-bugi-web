# Kakao Maps JavaScript key — safe to expose (protected by domain allowlist in Kakao console)
# Do NOT put the REST API key here; that one must stay server-only.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Supabase project settings
# OCR 진행상황 저장을 사용하려면 Anonymous sign-ins와
# supabase/migrations/20260826000000_ocr_review_results.sql을 적용하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Gateway (서버 전용 — 클라이언트에 노출 금지)
AI_GATEWAY_API_KEY=
# 모델 슬러그는 Vercel AI Gateway 모델 목록에서 확인 후 필요 시 교체
CHAT_SCREENING_MODEL=anthropic/claude-haiku-4.5
CHAT_ANSWER_MODEL=anthropic/claude-sonnet-5

# Supabase service role (서버 전용 — 채팅 저장 테이블 접근)
SUPABASE_SECRET_KEY=

# Server-only OCR settings. Never expose this key with a NEXT_PUBLIC_ prefix.
# Set OCR_MODE=demo to skip every external OCR API call during free testing.
OCR_MODE=demo
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.4-mini
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Set CHAT_MODE=disabled when OCR help questions must not call the API.
CHAT_MODE=disabled
